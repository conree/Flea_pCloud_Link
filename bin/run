#!/usr/bin/env python3
"""Flea plugin: Copy pCloud Link.

For files and folders under ~/pCloudDrive, asks rclone's pCloud remote (`pcloud:`) for a public
share link (`rclone link`) and puts the link(s) on the clipboard with wl-copy. Nothing is sent
anywhere else. Protocol: Flea's JSON-lines plugin protocol, version 1.
"""
import json
import os
import subprocess
import sys

ROOT = os.path.realpath(os.path.expanduser("~/pCloudDrive"))
REMOTE = "pcloud"
SETUP = "Set up pCloud in rclone first: run `rclone config create pcloud pcloud` in a terminal."
NO_RCLONE = "rclone couldn't run. Check that rclone and systemd-run are installed."


def rclone(*args, timeout):
    """Run rclone outside this process's limits: Flea caps a plugin at 512 MiB of address space,
    which is too little for rclone (a Go program) to start, so it runs as a transient unit of the
    user's systemd manager, with its output piped back here."""
    cmd = ["systemd-run", "--user", "--quiet", "--pipe", "--wait", "--collect", "--", "rclone", *args]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)


def answer(obj):
    print(json.dumps(obj), flush=True)


def has_remote():
    """True or False; None when rclone itself couldn't run."""
    try:
        done = rclone("listremotes", timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if done.returncode != 0:
        return None
    return f"{REMOTE}:" in done.stdout.split()


def relative(path):
    """The item's path inside pCloud, or None when it isn't in ~/pCloudDrive."""
    real = os.path.realpath(path)
    if real == ROOT or not real.startswith(ROOT + os.sep):
        return None
    return os.path.relpath(real, ROOT)


def make_link(rel):
    done = rclone("link", "--", f"{REMOTE}:{rel}", timeout=25)
    link = done.stdout.strip()
    if done.returncode != 0 or not link.startswith("https://"):
        reason = (done.stderr.strip().splitlines() or ["no link came back"])[-1]
        raise RuntimeError(reason[:300])
    return link


def copy(text):
    # wl-copy keeps a process alive to serve the clipboard; a session of its own keeps it alive
    # after Flea stops this plugin's process group.
    proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE, start_new_session=True,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    proc.communicate(text.encode("utf-8"), timeout=5)


def run(paths):
    rels = [(p, relative(p)) for p in paths]
    outside = [os.path.basename(p) for p, r in rels if r is None]
    if outside:
        return {"op": "error", "message": f"Only items in pCloud Drive (~/pCloudDrive) have pCloud links: {', '.join(outside[:3])}"}
    remote = has_remote()
    if remote is None:
        return {"op": "error", "message": NO_RCLONE}
    if not remote:
        return {"op": "error", "message": SETUP}
    links = []
    for i, (path, rel) in enumerate(rels, 1):
        answer({"op": "progress", "done": i - 1, "total": len(rels), "message": os.path.basename(path)[:200]})
        try:
            links.append(make_link(rel))
        except (OSError, subprocess.TimeoutExpired, RuntimeError) as e:
            return {"op": "error", "message": f"pCloud didn't make a link for {os.path.basename(path)}: {e}"[:1000]}
    try:
        copy("\n".join(links))
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"op": "error", "message": f"The link was made but couldn't be copied: {e}"[:1000]}
    if len(links) == 1:
        return {"op": "done", "message": f"Link copied: {links[0]}"[:1000]}
    return {"op": "done", "message": f"{len(links)} links copied, one per line."}


for line in sys.stdin:
    try:
        message = json.loads(line)
    except ValueError:
        continue
    op = message.get("op")
    if op == "cancel":
        break
    if op == "hello":
        answer({"op": "ready", "protocolVersion": 1})
    elif op == "settings":
        answer({"op": "done"})
    elif op == "run" and message.get("action") == "link":
        paths = [p for p in message.get("paths", []) if isinstance(p, str)]
        answer(run(paths) if paths else {"op": "error", "message": "Nothing was selected."})
    else:
        answer({"op": "error", "message": "Unknown request."})
